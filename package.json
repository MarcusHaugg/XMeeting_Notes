{
  "name": "xmeeting-notes",
  "productName": "XMeeting Notes",
  "version": "0.4.1",
  "private": true,
  "description": "Gravador de reuniões: grava microfone + áudio do sistema, transcreve no computador (ou com Gemini/OpenAI) e resume com a IA escolhida; login Google e Google Agenda.",
  "author": {
    "name": "XMeeting Notes",
    "email": "noreply@xmeetingnotes.app"
  },
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "server": "node --env-file-if-exists=server/.env server/index.js",
    "try-gemini": "node --env-file-if-exists=server/.env server/try-gemini.js",
    "selftest": "electron . --selftest=30",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "test": "node --no-deprecation --import ./test/register.mjs --test test/"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "electron-updater": "^6.8.12",
    "ffmpeg-static": "^5.3.0",
    "sherpa-onnx-node": "^2.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "app.xmeetingnotes",
    "productName": "XMeeting Notes",
    "artifactName": "XMeeting-Notes-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "MarcusHaugg",
        "repo": "XMeeting_Notes",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "renderer/**",
      "server/gemini.js",
      "server/errors.js",
      "server/summary.js",
      "build/icon.png",
      "app-config.json",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-*/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "XMeeting Notes",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "14.2",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "O XMeeting Notes usa o microfone para gravar a sua voz nas reuniões.",
        "NSAudioCaptureUsageDescription": "O XMeeting Notes grava o áudio do sistema para capturar a voz dos outros participantes da reunião."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "XMeeting Notes <noreply@xmeetingnotes.app>"
    }
  }
}
