# Copie para server/.env e preencha. O server/.env não vai para o git.
#
# Este servidor atende só o "plano da empresa": contas dos domínios em COMPANY_DOMAINS usam a
# chave do Gemini abaixo, paga pela empresa. Qualquer outra conta Google usa a própria chave
# do Gemini direto do app e nunca consome esta.

# Chave da API do Gemini da empresa, de um projeto do Google Cloud COM faturamento ativo
# (no plano gratuito o Google usa o conteúdo para melhorar os produtos dele).
GEMINI_API_KEY=

# ID do cliente OAuth do tipo "App para computador" (o mesmo de app-config.json).
# Vários separados por vírgula.
GOOGLE_CLIENT_IDS=

# Domínios cujo uso esta chave paga, separados por vírgula. Obrigatório.
COMPANY_DOMAINS=bimachine.com.br

# Opcionais
# PORT=8080
# TRANSCRIBE_MODEL=gemini-3.5-transcribe
# SUMMARY_MODEL=gemini-3.8-flash
# GEMINI_API_REVISION=2026-05-20
# Arquivo com uma linha por chamada (quem, modelo, tokens). Vazio = só no log do console.
# USAGE_LOG=server/usage.jsonl
